#!/usr/bin/env bash
# mythical-ctl — installer and lifecycle CLI for the mythicalOS family.
# Copyright 2026 mythicalOS. Licensed under the Apache License, Version 2.0.
#
# Shell, deliberately: this runs before any language runtime is guaranteed to
# exist on the machine. Its only dependencies are bash and a container runtime.
#
# Bash specifically, not POSIX sh — `set -o pipefail` below is a bash builtin.
# Saying "POSIX shell" here while shipping a bash script would be a portability
# claim the code does not honour.
#
# The lifecycle verbs are specified but NOT YET IMPLEMENTED — see README.md.
# This entrypoint carries the version and the help surface so that packaging,
# release and installation can be built and tested ahead of them.

set -euo pipefail

VERSION="0.1.0"

# Resolve lib/ relative to this script (symlink-safe enough for install + repo layouts).
_MCTL_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_MCTL_LIB="${_MCTL_BIN}/../lib"

usage() {
  cat <<'EOF'
mythical-ctl — install and manage mythicalOS products

USAGE
  mythical-ctl <command> [options]

COMMANDS
  (none yet — the lifecycle commands land with the implementation)

OPTIONS
  -v, --version   print the version and exit
  -h, --help      print this help and exit

Products are not published yet. See https://github.com/mythicalOS/mythical-ctl
EOF
}

main() {
  if [ "$#" -eq 0 ]; then
    usage
    exit 0
  fi

  case "$1" in
    -v|--version)
      printf 'mythical-ctl %s\n' "$VERSION"
      ;;
    -h|--help)
      usage
      ;;
    __selftest)
      # Hidden: prove every SHIPPED lib/ module sources cleanly. Guarded exactly like load_mctl so
      # it works at any task stage — a module a later task adds is simply skipped until it exists,
      # never a fatal missing-source under the entrypoint's `set -e`. Used by the tests, undocumented.
      # shellcheck disable=SC1090
      for _m in common layout lock ledger; do [ -f "${_MCTL_LIB}/${_m}.sh" ] && source "${_MCTL_LIB}/${_m}.sh"; done
      printf 'ok\n'
      ;;
    *)
      # Exit 2 for usage errors, distinct from 1 for operational failure, so a
      # caller can tell "you typed it wrong" from "it tried and could not".
      printf 'mythical-ctl: unknown command: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
