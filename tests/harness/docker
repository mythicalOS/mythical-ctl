#!/usr/bin/env bash
# Fake container runtime for the hermetic acceptance harness (test-only; never shipped).
#
# It exists so §10a can assert over BOTH worlds — the filesystem and the runtime — without a real
# daemon. Fidelity is the whole point, so the behaviours the design of record calls out as verified
# are reproduced here even where a simpler fake would pass the tests:
#
#   * `volume create` on an existing name SUCCEEDS and does NOT apply the new labels (D56/§6c).
#   * A STOPPED container has NO address; `start` assigns one and `stop` releases it (D48).
#   * `network create` can be made to produce a duplicate name+nonce pair (D38) via
#     FAKE_DOCKER_NET_DUPLICATE, because Docker does not guarantee name-conflict detection there.
#   * `inspect` of an absent object exits nonzero while `version` still answers, which is how the
#     adapter distinguishes "absent" (rc 3) from "daemon down" (rc 1).
#   * `container create` and `container run` REFUSE an image that was never pulled, as a real daemon
#     does. Permissiveness here is not a harmless simplification: it lets a caller that forgot to
#     pull pass its tests and fail against a real daemon.
#   * `--mount type=bind` REFUSES a source that does not exist — the documented reason the adapter
#     uses `--mount` rather than `-v`, which silently creates one.
#   * A `--network` value is RESOLVED against the networks this fake actually has, and the attachment
#     is recorded under the network's ID — never under the name it was reached by.
#   * `network create` records the driver it was ASKED for, so `--driver bridge` is a flag a test can
#     observe rather than one the fake assumes.
#   * Every subcommand answers only the FLAGS and TEMPLATES it implements, and takes only the number
#     of positional arguments it can act on. An unimplemented flag is a hard error, never a silent
#     no-op (§"the closed surface" below).
#   * A resource that is still REFERENCED cannot be removed: a network with an attached container, a
#     volume a container mounts, a running container without `-f`.
#   * A container joins a network under its own NAME as well as any explicit alias, so an omitted
#     `--alias` is observable rather than invisible.
#   * `container run` WITHOUT `--rm` leaves the container behind, as a real daemon does.
#   * A container's NAME and its `--network-alias`es are answered by the NETWORK RESOLVER; only its
#     HOSTNAME is in its own hosts file. The two surfaces are handed to the helper entrypoint
#     separately, so a selfcheck that answers out of the wrong one is observably different.
#   * `container run -i` is ACCEPTED (Task 13/D59): stdin already reaches the fixture entrypoint
#     unconditionally here, so the flag is a no-op rather than a knob — but it must be RECOGNISED, not
#     bounced by the closed-surface gate, since the adapter sends it whenever a caller (restore's
#     manifest verification) needs the helper to read from stdin.
#
# THE CLOSED SURFACE — why an unimplemented flag is fatal here.
# Every parse loop below used to end in a catch-all that either swallowed the word (`*) shift`) or
# took it as the name. MEASURED against that version:
#
#   docker container run --network none -v /:/hostroot -- img selfcheck   → rc 0, the `-v` IGNORED
#   docker container create --name c1 … --user 1000 --env-file /nope …    → rc 0, both IGNORED
#   docker volume create v2 v3                                            → rc 0, created v3 only
#   docker container create … -- img sleep infinity                       → the COMMAND became the image
#
# A fake that ignores a flag is worse than one that lacks it: the first case is a container escape a
# test would report as clean. So an unknown flag DIES, and the message says `fake docker:` rather
# than borrowing Docker's `unknown flag:` — the fake cannot tell "Docker has no such flag" from
# "Docker has it and this fake does not implement it", and pretending otherwise would put words in a
# real daemon's mouth. The `--flag=value` spelling is implemented only where a caller uses it
# (`--label=`, `--driver=`); elsewhere it is refused rather than accepted and ignored.
#
# Knobs: FAKE_DOCKER_DOWN, FAKE_DOCKER_DOWN_AFTER, FAKE_DOCKER_DOWN_FROM, FAKE_DOCKER_INSPECT_MISSING,
#        FAKE_DOCKER_INFO_FAIL, FAKE_DOCKER_SERVER_VERSION,
#        FAKE_DOCKER_CLIENT_VERSION, FAKE_DOCKER_ROOTLESS,
#        FAKE_DOCKER_CONTEXT_HOST, FAKE_DOCKER_PULL, FAKE_DOCKER_NET_DUPLICATE,
#        FAKE_DOCKER_NET_DRIVER, FAKE_DOCKER_NET_DEFAULT_DRIVER, FAKE_DOCKER_NET_THI,
#        FAKE_DOCKER_HELPER_FAIL, FAKE_DOCKER_CONNECT_FAIL, FAKE_DOCKER_DISCONNECT_SILENT
#
# FAKE_DOCKER_DOWN and FAKE_DOCKER_INFO_FAIL are NOT two settings of one thing. The first fails EVERY
# command, `version` included, which is what makes the adapter's absent-vs-unreachable split
# observable. The second fails `info` ALONE, leaving `version` answering, so a probe that reads `info`
# can be made to report "could not ask" without the caller's earlier ping refusing first. Broadening
# either to cover the other's case would mask a refusal the suite is meant to pin — see the `info`
# arm below.
#
# THE TWO RACE KNOBS ARE NOT SETTINGS OF FAKE_DOCKER_DOWN EITHER, and they are not settings of each
# other. A daemon that was already down when an operation started is the easy case: the operation's
# FIRST query refuses and nothing has been decided yet. The failures that matter to recovery happen
# BETWEEN two queries of one operation — a listing that answered, and then a question about what it
# named that did not — and there are exactly two of those, which the adapter reports differently and
# which authorize completely different things:
#
#   FAKE_DOCKER_DOWN_AFTER=<n>        the first <n> invocations made WHILE THIS IS SET answer, and
#                                     every one after them dies exactly as FAKE_DOCKER_DOWN does,
#                                     `version` included. The adapter's ping therefore also fails, so
#                                     mi_rt_inspect reports 1 — THE QUESTION COULD NOT BE ASKED, which
#                                     authorizes nothing at all. The counter lives in a file created
#                                     only when the knob is set, so it counts the calls of the
#                                     operation under test and nothing else.
#   FAKE_DOCKER_INSPECT_MISSING=<name>  `<kind> inspect` of that exact name reports no such object,
#                                     while the daemon keeps answering everything else — from the
#                                     first such inspect, or from the one after
#                                     FAKE_DOCKER_INSPECT_MISSING_AFTER=<n> of them, which is how an
#                                     object that vanishes BETWEEN two questions of one operation is
#                                     built. The
#                                     adapter's ping succeeds, so mi_rt_inspect reports 3 — THE OBJECT
#                                     IS GENUINELY GONE, which is a fact a later run can act on. This
#                                     is what an object being removed between a listing and the
#                                     inspection of what the listing named looks like.
#
# Folding either into the other would make a recovery path that adopts on an unanswered question
# indistinguishable from one that correctly handles an object that vanished.
#
# The two driver knobs are NOT the same thing, and the difference is load-bearing:
#
#   FAKE_DOCKER_NET_DRIVER          OVERRIDES whatever driver was requested. It exists to FABRICATE a
#                                   network the adapter cannot legitimately create — a macvlan or
#                                   ipvlan one — so the preflight refusals have something to refuse.
#                                   It has to keep winning: honouring `--driver` naively would make
#                                   those refusals untestable, trading one fidelity gap for another.
#   FAKE_DOCKER_NET_DEFAULT_DRIVER  the driver used when the caller passes NO `--driver` at all. It
#                                   models D29's stated threat — a daemon whose default is not a NAT
#                                   bridge — which is the only condition under which an EXPLICIT
#                                   `--driver bridge` is observably different from omitting it.
set -euo pipefail

STATE="${FAKE_DOCKER_STATE:-${MYTHICAL_HOME:-/tmp}/.fake-docker}"
mkdir -p "$STATE/volumes" "$STATE/networks" "$STATE/containers" "$STATE/images"
printf '%s\n' "$*" >> "$STATE/calls.log"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

# FAKE_DOCKER_INTERRUPT_AFTER=<subcommand> fabricates the process dying AT a named step — the
# `<verb> <sub>` pair (e.g. `container create`) is compared against "$1 $2", and when it matches the
# command dies BEFORE doing its work, so the object it would have created never exists. It is a
# fabricated-failure knob like FAKE_DOCKER_DOWN/CONNECT_FAIL, inert unless set, and it exists to build
# the "an interrupted install converges on a re-run" acceptance case: the volume is already created and
# the container intent is already open, but the container itself is not, which is precisely the
# write-ahead window recovery must close.
if [ -n "${FAKE_DOCKER_INTERRUPT_AFTER:-}" ] && [ "${1:-} ${2:-}" = "$FAKE_DOCKER_INTERRUPT_AFTER" ]; then
  die "fake docker: interrupted at '${FAKE_DOCKER_INTERRUPT_AFTER}'"
fi

# A down daemon fails EVERY command, including version — that is what makes the adapter's
# absent-vs-unreachable split observable.
[ -z "${FAKE_DOCKER_DOWN:-}" ] || die "Cannot connect to the Docker daemon. Is the docker daemon running?"

# FAKE_DOCKER_DOWN_FROM=<subcommand> — the daemon answers normally until a call whose "$1 $2" equals
# the value; from THAT call onward every command dies exactly as FAKE_DOCKER_DOWN does, `version`
# included. Unlike DOWN_AFTER (which counts calls), this latches the daemon's failure to a SPECIFIC
# operation, so a test that must make one named step — and the adapter's own follow-up ping about
# it — unanswerable does not depend on counting every call that preceded it. A marker file latches it
# so the later calls, which no longer match the subcommand, die too. Inert unless set; a fabricated
# failure like FAKE_DOCKER_DOWN/CONNECT_FAIL, never reachable on a real daemon.
if [ -n "${FAKE_DOCKER_DOWN_FROM:-}" ]; then
  df_marker="$STATE/down-from.latched"
  if [ -e "$df_marker" ] || [ "${1:-} ${2:-}" = "$FAKE_DOCKER_DOWN_FROM" ]; then
    : > "$df_marker"
    die "Cannot connect to the Docker daemon. Is the docker daemon running?"
  fi
fi

# The daemon goes down PART WAY THROUGH an operation: the first <n> calls answer, the rest do not.
# Counted in a file that only exists while the knob is set, so the count is the operation's own.
if [ -n "${FAKE_DOCKER_DOWN_AFTER:-}" ]; then
  da_file="$STATE/down-after.count"; da_n=0
  [ ! -f "$da_file" ] || da_n="$(cat "$da_file")"
  da_n=$((da_n + 1)); printf '%s\n' "$da_n" > "$da_file"
  [ "$da_n" -le "$FAKE_DOCKER_DOWN_AFTER" ] || die "Cannot connect to the Docker daemon. Is the docker daemon running?"
fi

# One object is not there any more, while the daemon still answers. Applied HERE rather than in each
# `inspect` arm: a knob honoured for volumes and not for networks would be the same "a rule that holds
# on one path and not its neighbours" bug in the instrument used to find it. The kind and the verb
# are skipped so a knob value that happens to spell one cannot match them, and `--format`'s argument
# is skipped because a template is not a name.
if [ -n "${FAKE_DOCKER_INSPECT_MISSING:-}" ] && [ "${2:-}" = inspect ]; then
  case "${1:-}" in
    container|network|volume|image)
      im_skip=0; im_n=0
      for im_a in "$@"; do
        im_n=$((im_n + 1))
        [ "$im_n" -gt 2 ] || continue
        if [ "$im_skip" = 1 ]; then im_skip=0; continue; fi
        case "$im_a" in --format) im_skip=1; continue ;; -*) continue ;; esac
        [ "$im_a" = "$FAKE_DOCKER_INSPECT_MISSING" ] || continue
        # _AFTER lets the object survive its first <n> inspections and disappear before the next one.
        # One operation asks about one object more than once — whose is it, and then what is it — and
        # each of those is a separate question that can be answered separately. Without this, the
        # FIRST question always sees the object gone and every later one is unreachable, which is
        # exactly how two honest-failure arms ended up unpinned by the suite.
        im_after="${FAKE_DOCKER_INSPECT_MISSING_AFTER:-0}"
        im_file="$STATE/inspect-missing.count"; im_c=0
        [ ! -f "$im_file" ] || im_c="$(cat "$im_file")"
        im_c=$((im_c + 1)); printf '%s\n' "$im_c" > "$im_file"
        [ "$im_c" -le "$im_after" ] || die "No such object: $im_a"
      done ;;
  esac
fi

# Monotonic ids without $RANDOM, so a run is reproducible.
next_id() {
  local n=0
  [ ! -f "$STATE/next-id" ] || n="$(cat "$STATE/next-id")"
  n=$((n + 1)); printf '%s' "$n" > "$STATE/next-id"
  printf '%064d\n' "$n"
}

# Records are `key=value` lines. Values never contain a newline in any fixture.
rec_get() { sed -n "s/^${2}=//p" "$1" 2>/dev/null | head -n1; }
rec_set() {
  local f="$1" k="$2" v="$3" t
  # `.tmp-XXXXXX`, NOT `${f}.XXXXXX`: mktemp SUBSTITUTES the X's, so a temp named `${f}.XXXXXX`
  # lands on disk as e.g. `v1.aB3xY9` and the `*.XXXXXX*` skip-filters in `volume ls` and
  # `snap_runtime` never match it. Those filters are meant to hide a crash leftover from being
  # listed as a volume; with this prefix `*.tmp*` actually matches and they do their job.
  t="$(mktemp "${f%/*}/.tmp-XXXXXX")"
  { grep -av "^${k}=" "$f" 2>/dev/null || true; printf '%s=%s\n' "$k" "$v"; } > "$t"
  mv -f "$t" "$f"
}

# --- argument discipline (see "THE CLOSED SURFACE" above) ------------------------------------------
# One flag the fake does not implement; one positional argument too many. Both were silent.
bad_flag() { die "fake docker: $1 does not implement the flag $2"; }
# <already-taken> <arm> <what> <new>. Docker's CLI errors on a second positional ("requires exactly 1
# argument"); this fake kept the LAST and discarded the rest, so a stray or typo'd word looked fine.
one_only() {
  [ -z "$1" ] || die "fake docker: $2 takes exactly one $3 (got '$1' and '$4')"
}

# A `ls --format` template was parsed off and thrown away, so EVERY template printed the name. An
# adapter asking for the driver, the id or the image would have been answered with names and the
# lookup that consumed them would have "worked". Same rule as render(): only what is implemented.
check_ls_format() {
  case "$1:$2" in
    volume:|network:|container:) return 0 ;;
    volume:'{{.Name}}'|network:'{{.Name}}'|container:'{{.Names}}') return 0 ;;
    *) die "fake docker: unsupported $1 ls template: $2" ;;
  esac
}

# `--filter` is honoured for `label=` only, and a second one is refused rather than silently
# replacing the first: real Docker ANDs them, and a fake that keeps the last would answer a
# two-filter query with a one-filter result. A non-label filter matched NOTHING here and reported
# success, which is the emptiest possible wrong answer.
set_filter() {
  [ -z "$1" ] || die "fake docker: $2 supports one --filter, not two (got '$1' and '$3')"
  case "$3" in label=*) : ;; *) die "fake docker: $2 implements only label= filters, not '$3'" ;; esac
}

# --- resource names ---
# Docker-controlled names are used below as PATH COMPONENTS ($STATE/<kind>/<name>). Unvalidated they
# are a traversal, MEASURED against this fake before the check existed, with $STATE two levels down
# and a file holding 'IMPORTANT DATA' beside it:
#
#   docker network create   ../../escapee     → rc 0, a 122-byte network record CREATED outside $STATE
#   docker volume create    ../../canary      → rc 0, the outside file ADOPTED as an existing volume
#   docker volume inspect   ../../canary      → rc 0, { "Name": "../../canary", … } — outside file READ
#   docker container start  ../../canary      → rc 0, rec_set's `mv -f` REWROTE the outside file
#
# Two things are wrong with that. It escapes test isolation — a suite can clobber anything the
# developer running it can write — and it makes this fake MORE PERMISSIVE THAN THE REAL DAEMON, which
# is the one thing it must never be. Moby refuses these names outright: container names against
# `^/?[a-zA-Z0-9][a-zA-Z0-9_.-]+$` (its own error names that class), and local volume names against
# the same character class. A guard that only ever runs against a fake that accepts what Docker
# rejects is decoration, and can be deleted with the whole suite green.
#
# Applied on EVERY subcommand that takes a name, not only create: inspect, rm, start, stop, connect
# and disconnect all resolve their argument into the same directory, as the two rc-0 lookups above
# show. The empty name is refused here too — `$STATE/containers/` is the containers DIRECTORY, `[ -e ]`
# accepts it, and the pre-check fake rendered a field from it and exited 0.
#
# Three deliberate boundaries, stated rather than hidden:
#   * NETWORKS. libnetwork's own rule is only "non-empty after trimming", so this class is STRICTER
#     than the real daemon for networks. Stricter is the safe direction — it can only refuse early,
#     where looser turns a load-bearing guard into decoration — and every name this installer
#     constructs comes from lib/manifest.sh's mi_name_* helpers, well inside the class.
#   * ORDER. This fake refuses an invalid name BEFORE it resolves the image, where the real daemon
#     resolves the image first. Both refuse; only the message differs, and only for a caller that
#     supplies an invalid name AND an unpulled image.
#   * IMAGE REFERENCES are NOT checked here — a reference legitimately contains `/`, `:` and `@`.
#     They are safe for a different reason: image_key() below hashes the reference instead of
#     spelling it into a path. A `--network` VALUE is not name-checked either: `container:<name>` is a
#     real network mode, so the class does not fit it, and the value is not spelled into a path —
#     resolve_netid() compares it against stored records and refuses anything that matches none,
#     which is a stricter answer than this rule would give. The container half of
#     `container:<name>` IS a path, and does go through check_name.
#
# The `*/*` arm is not redundant with the character class: bash pattern ranges are locale-collated,
# so `[a-zA-Z0-9_.-]` is only approximately the set it reads as. The one character that turns a name
# into a path is pinned explicitly and cannot depend on the operator's locale.
check_name() {
  local n="$1" kind="$2"
  case "$n" in
    ''|*/*|[!a-zA-Z0-9]*|*[!a-zA-Z0-9_.-]*) : ;;
    *) return 0 ;;
  esac
  case "$kind" in
    container) die "Invalid container name ($n), only [a-zA-Z0-9][a-zA-Z0-9_.-] are allowed" ;;
    volume)    die "create $n: \"$n\" includes invalid characters for a local volume name, only \"[a-zA-Z0-9][a-zA-Z0-9_.-]\" are allowed. If you intended to pass a host directory, use absolute path" ;;
    *)         die "invalid network name ($n), only [a-zA-Z0-9][a-zA-Z0-9_.-] are allowed" ;;
  esac
}

# --- image presence, shared by pull, inspect, create and run ---
# ONE derivation of the on-disk key, so `pull` and the gates below cannot disagree about what counts
# as the same image.
#
# It is a DIGEST of the exact reference, not a character fold. `tr -c 'A-Za-z0-9._-' '_'` mapped
# `foo/bar:tag` and `foo_bar:tag` to the same key `foo_bar_tag`, so pulling either satisfied the
# create/run gate for the other — and that gate is the thing that stops a task which forgot to pull
# from passing here and failing against a real daemon. An aliasing key does not weaken the gate a
# little; it means the gate no longer asserts "this reference was pulled" at all. Real Docker treats
# the two as different repositories.
#
# sha256sum (Linux) or shasum -a 256 (macOS) — the same floor lib/common.sh's mi_digest uses, spelled
# out again on purpose: this harness is a standalone script on PATH and must not source lib/.
image_key() {
  local h
  if command -v sha256sum >/dev/null 2>&1; then
    h="$(printf '%s' "$1" | sha256sum)"
  elif command -v shasum >/dev/null 2>&1; then
    h="$(printf '%s' "$1" | shasum -a 256)"
  else
    die "fake docker: no sha256 implementation found (need sha256sum or shasum)"
  fi
  printf '%s/images/%s' "$STATE" "${h%% *}"
}

# Real Docker cannot create or run a container from an image it does not hold: it attempts a pull and
# then errors. A fake that records the container regardless lets a later task that FORGOT to pull
# pass its tests and fail against a real daemon — and it makes two §10a rows unprovable, since
# "not launched ⇒ no pull attempted" and "launched manifest + image not found ⇒ loud release error"
# both rest on create being the thing that cannot succeed without the image.
require_image() {
  [ -n "$1" ] || die "no image reference"
  [ -e "$(image_key "$1")" ] || die "Unable to find image '$1' locally"
}

# --- mount validation ---
# `--mount type=bind` REFUSES a source that does not exist. That refusal is the stated reason the
# adapter uses `--mount` rather than `-v`, which silently CREATES a missing source as a directory —
# which is how a single-file bind stops being the file the product writes. The fake checked nothing,
# so the guarantee that comment claims was asserted by no test at all.
check_mounts() {
  local spec src
  local IFS=';'
  # shellcheck disable=SC2086   # deliberate split: the mount list is `;`-separated by the parser above
  for spec in $1; do
    case "$spec" in type=bind,*) : ;; *) continue ;; esac
    src="${spec#*source=}"; src="${src%%,*}"
    [ -e "$src" ] || die "invalid mount config for type \"bind\": bind source path does not exist: $src"
  done
}

# A NAMED VOLUME that does not exist is CREATED by the daemon as part of the container create — the
# asymmetry with bind mounts above is real and deliberate on Docker's part. This fake recorded the
# mount and created nothing, which is the permissiveness gap read from the other side: the runtime
# world it showed had FEWER objects in it than a real daemon's would, so a §10a assertion of the
# "nothing partial survives" kind could pass here over an orphan volume that really would be left
# behind. The auto-created volume carries no labels, exactly as the daemon's does — which is also why
# it is worth seeing: an unlabelled volume is invisible to every find-by-label sweep in §6a.
create_missing_volumes() {
  local spec name
  local IFS=';'
  # shellcheck disable=SC2086   # deliberate split: the mount list is `;`-separated by the parser above
  for spec in $1; do
    case "$spec" in type=volume,*) : ;; *) continue ;; esac
    name="${spec#*source=}"; name="${name%%,*}"
    [ -n "$name" ] || continue
    check_name "$name" volume
    if [ ! -e "$STATE/volumes/$name" ]; then
      : > "$STATE/volumes/$name"
      rec_set "$STATE/volumes/$name" labels ""
      rec_set "$STATE/volumes/$name" driver local
    fi
  done
}

# --- networks: resolution and drivers ---
# A real daemon RESOLVES a network reference — by ID or by name — against the networks it has, and
# refuses one it does not. This fake required only a non-empty string, so `container create --network
# nonexistent` and `network connect nonexistent c1` both succeeded here and are both rejected there.
#
# The cost is bigger than the fidelity gap. Bring-up's step 2 is "verify the container is attached to
# exactly the EXPECTED network ID", and a fake that accepts any string as a network — and then echoes
# that string back as the attachment — cannot fail a missing or broken ID-propagation guard. So the
# lookup below returns the network's ID, and the attachment is recorded under THAT, never under the
# name the caller happened to use.
#
# ONE lookup, used by inspect, rm, connect, create and run: `network inspect` already had this loop
# inline, and a second copy is how two answers to "does this network exist?" start to differ.
find_network() {
  local key="$1" n
  for n in "$STATE"/networks/*; do
    [ -e "$n" ] || continue
    if [ "$(rec_get "$n" id)" = "$key" ] || [ "$(rec_get "$n" name)" = "$key" ]; then
      printf '%s' "$n"; return 0
    fi
  done
  return 1
}

# Resolve a `--network` value the way the daemon does and echo what the attachment must be recorded
# under. Dies (in the caller's subshell) when the network is absent.
#
# The PRE-DEFINED modes are deliberately accepted WITHOUT a lookup. `none`, `host`, `bridge` and
# `container:<name>` are real values a real daemon takes, and lib/runtime.sh refuses three of them
# itself (D26/D42) — so a fake that refused them here would be the one doing the refusing, and the
# adapter's guard could be deleted with the suite green. That is finding 2's failure class wearing a
# different hat, and it is why "stricter than Docker" is not automatically the safe direction.
# `container:<name>` names a container, which a real daemon does resolve, so it is looked up.
resolve_netid() {
  local spec="$1" f c
  case "$spec" in
    bridge|host|none) printf '%s' "$spec"; return 0 ;;
    container:*)
      c="${spec#container:}"
      check_name "$c" container
      [ -e "$STATE/containers/$c" ] || die "no such container: $c"
      printf '%s' "$spec"; return 0 ;;
  esac
  if f="$(find_network "$spec")"; then rec_get "$f" id; return 0; fi
  die "network $spec not found"
}

# `--driver` was consumed and DISCARDED, and every network was recorded as bridge. So
# `--driver bridge` — the D29 NAT wall, passed explicitly precisely because relying on a daemon
# default for a security property is how the wall disappears without a diff — could be deleted from
# the adapter with the entire suite still green. A guard no test can pin is decoration.
#
# The accepted set is the local, non-swarm one. `overlay` needs a swarm manager and `host`/`none` are
# pre-defined networks, and a real daemon refuses both requests on an ordinary single-node host —
# which is the only host this installer supports.
check_driver() {
  case "$1" in
    ''|bridge|macvlan|ipvlan) return 0 ;;
    host|none) die "only one instance of \"$1\" network is allowed" ;;
    overlay)   die "This node is not a swarm manager. Use \"docker swarm init\" or \"docker swarm join\" to connect this node to swarm and try again" ;;
    *)         die "could not find plugin $1 in v1 plugin registry: plugin not found" ;;
  esac
}

# --- what is still USING a resource -----------------------------------------------------------------
# A real daemon refuses to remove something that is still referenced, and the refusal is the whole
# safety property in §6b's teardown ordering: detach, THEN remove. This fake removed either happily
# and left every container holding an id that resolves to nothing — so a teardown that removed the
# network first, or removed a volume out from under a live container, passed here and would fail (or
# worse, half-succeed) against a real daemon.
#
# Attachments are stored as `nets=<id>=<addr>;…` and mounts as `mounts=volume|<name>||<dst>|<rw>;…`,
# so both scans prefix a `;` and match a delimited field — never a bare substring, which would make
# volume `v` look like a user of `vv`.
container_ids_on_network() {
  local c out=""
  for c in "$STATE"/containers/*; do
    [ -e "$c" ] || continue
    case ";$(rec_get "$c" nets)" in *";${1}="*) out="${out}$(rec_get "$c" id) " ;; esac
  done
  printf '%s' "${out% }"
}
container_ids_using_volume() {
  local c out=""
  for c in "$STATE"/containers/*; do
    [ -e "$c" ] || continue
    case ";$(rec_get "$c" mounts)" in *"volume|${1}|"*) out="${out}$(rec_get "$c" id) " ;; esac
  done
  printf '%s' "${out% }"
}

# --- label parsing, shared by every create ---
labels=""
parse_label() { labels="${labels}${1};"; }
label_of() {
  local blob="$1" key="$2" pair
  local IFS=';'
  for pair in $blob; do
    case "$pair" in "mythicalos.${key}="*) printf '%s' "${pair#*=}"; return 0 ;; esac
  done
  return 0
}
has_label() {
  local blob="$1" want="$2" pair
  local IFS=';'
  for pair in $blob; do [ "$pair" = "$want" ] && return 0; done
  return 1
}

# --- template rendering ---
# Only the templates lib/runtime.sh actually emits are understood. An unknown one is a HARD ERROR,
# not an empty string: a silently-empty render is how a fake makes a broken adapter look correct.
# shellcheck disable=SC2016   # the case patterns ARE Go templates; every $ belongs to them
render() {
  local tmpl="$1" f="$2" kind="$3"
  case "$tmpl" in
    # NOT `[ … ] && printf true || printf false`: the Global Constraints forbid `A && B || C`
    # outright. (Local shellcheck 0.11.0 does not flag this particular instance — the constraint is
    # the reason to avoid it, not a prediction about the linter.)
    '{{.State.Running}}')   if [ "$(rec_get "$f" state)" = running ]; then printf 'true\n'; else printf 'false\n'; fi ;;
    '{{.State.Status}}')    printf '%s\n' "$(rec_get "$f" state)" ;;
    '{{.Image}}')           printf '%s\n' "$(rec_get "$f" image)" ;;
    '{{.Id}}')              printf '%s\n' "$(rec_get "$f" id)" ;;
    '{{.Driver}}')          printf '%s\n' "$(rec_get "$f" driver)" ;;
    '{{index .Config.Labels "mythicalos.nonce"}}'|'{{index .Labels "mythicalos.nonce"}}')
                            printf '%s\n' "$(label_of "$(rec_get "$f" labels)" nonce)" ;;
    '{{index .Config.Labels "mythicalos.installation"}}'|'{{index .Labels "mythicalos.installation"}}')
                            printf '%s\n' "$(label_of "$(rec_get "$f" labels)" installation)" ;;
    '{{index .Config.Labels "mythicalos.product"}}')
                            printf '%s\n' "$(label_of "$(rec_get "$f" labels)" product)" ;;
    '{{index .Options "com.docker.network.bridge.trusted_host_interfaces"}}')
                            printf '%s\n' "$(rec_get "$f" thi)" ;;
    '{{range $k,$v := .NetworkSettings.Networks}}{{$v.NetworkID}}={{$v.IPAddress}};{{end}}')
                            printf '%s\n' "$(rec_get "$f" nets)" ;;
    '{{range $k,$v := .NetworkSettings.Networks}}{{$v.NetworkID}}:{{range $v.Aliases}}{{.}},{{end}};{{end}}')
                            printf '%s\n' "$(rec_get "$f" aliases)" ;;
    '{{range .Mounts}}{{.Type}}|{{.Name}}|{{.Source}}|{{.Destination}}|{{.RW}};{{end}}')
                            printf '%s\n' "$(rec_get "$f" mounts)" ;;
    '{{range $p,$bs := .NetworkSettings.Ports}}{{range $bs}}{{$p}}={{.HostIp}}:{{.HostPort}};{{end}}{{end}}')
                            printf '%s\n' "$(rec_get "$f" ports)" ;;
    '{{index .RepoDigests 0}}') printf '%s\n' "$(rec_get "$f" ref)" ;;
    *) die "fake docker: unsupported ${kind} template: ${tmpl}" ;;
  esac
}

# The alias list an attachment gets: the EXPLICIT alias, if any, and then the container's own name,
# which a real daemon adds by itself on a user-defined network.
#
# That automatic name is not decoration. Without it an omitted `--alias` / `--network-alias` recorded
# an EMPTY alias list, which is indistinguishable from nothing at all — so §6b.2's "the alias is
# passed explicitly, because a container joining under its own installation-scoped name is a name no
# sibling can guess" was a guarantee no test could fail on. With the name always present, dropping
# the flag leaves the list holding the container name ALONE, which is exactly the failure §9 calls
# "family DNS fails silently, indistinguishable from an absent peer".
#
# The ORDER (explicit first) is this fake's own, not a fidelity claim: Docker's Aliases/DNSNames
# ordering has changed across engine versions and nothing here should depend on it.
alias_list() {
  if [ -n "$1" ]; then printf '%s,%s,' "$1" "$2"; else printf '%s,' "$2"; fi
}

# The address a started container gets on a network. Deterministic per (container, netid).
addr_for() { printf '10.88.%d.%d\n' $(( $(printf '%s' "$1$2" | cksum | cut -d' ' -f1) % 250 + 1 )) $(( ${#1} % 250 + 2 )); }

# The container's own HOSTNAME as the daemon assigns it: the short form of the id it minted, NOT the
# container's name and NOT any alias. That distinction is the whole of the selfcheck property below,
# so the fake keeps it: whatever else ends up in a hosts file, the hostname is a name the IMAGE could
# in principle have known nothing about but the RESOLVER was never asked for.
short_id() { printf '%012x\n' "$(printf '%s' "$1" | cksum | cut -d' ' -f1)"; }

# --- the two NAME-RESOLUTION SURFACES a container really has ---------------------------------------
# A container turns a name into an address two ways, and they are not interchangeable:
#
#   its hosts file   what the daemon WRITES INTO the container at start — localhost, and the
#                    container's own HOSTNAME. It is a file inside the container; a dead network
#                    resolver does not stop it answering.
#   the network      the embedded DNS server on a user-defined network, which answers for every
#   resolver         container's NAME and for every --network-alias registered on it. A NETWORK ALIAS
#                    IS ONLY EVER HERE.
#
# D49's selfcheck rests entirely on that last sentence: the caller mints an alias per run, registers
# it with the network, and asks the probe to resolve it — a name that did not exist when the image was
# built and that no hosts file contains. Modelling the two surfaces SEPARATELY is what lets a test
# install a hosts-file selfcheck and watch it fail; merged into one map, the two implementations would
# be indistinguishable here and the property would be asserted by nothing.
#
# Both are handed to the fixture entrypoint as `;`-separated `name=address` lists. The DNS view holds
# every name the network answers for; a STOPPED container contributes none, because the daemon
# releases its address and the resolver stops answering for it (the same D48 fidelity `stop` keeps).
dns_view_for() {
  local net="$1" c caddr pair grp a out=""
  for c in "$STATE"/containers/*; do
    [ -e "$c" ] || continue
    caddr=""
    for pair in $(printf '%s' "$(rec_get "$c" nets)" | tr ';' ' '); do
      case "$pair" in "${net}="*) caddr="${pair#*=}" ;; esac
    done
    [ -n "$caddr" ] || continue
    for grp in $(printf '%s' "$(rec_get "$c" aliases)" | tr ';' ' '); do
      case "$grp" in "${net}:"*) : ;; *) continue ;; esac
      for a in $(printf '%s' "${grp#*:}" | tr ',' ' '); do
        out="${out}${a}=${caddr};"
      done
    done
  done
  printf '%s' "$out"
}

case "${1:-}" in
  version)
    # The SERVER version, and only when that is what was asked for. This arm printed the server
    # version for EVERY template, including `{{.Client.Version}}` — so the adapter could have been
    # reading the CLI's own version and the preflight engine-version gate (D29, engine 28+) would
    # have compared the wrong number with the suite green. `docker version` mixes client and server
    # fields in one document; which one a caller asked for is exactly the thing worth pinning.
    shift; tmpl=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --format) tmpl="$2"; shift 2 ;;
        --format=*) tmpl="${1#--format=}"; shift ;;
        -*) bad_flag "version" "$1" ;;
        *) die "fake docker: version accepts no arguments (got '$1')" ;;
      esac
    done
    case "$tmpl" in
      # No --format: real docker prints a client block and a server block. Both are printed here so
      # a bare `docker version` still answers, and so the two are visibly DIFFERENT fields.
      '') printf 'Client:\n Version: %s\n\nServer:\n Engine:\n  Version: %s\n' \
            "${FAKE_DOCKER_CLIENT_VERSION:-99.0.0}" "${FAKE_DOCKER_SERVER_VERSION:-28.0.0}" ;;
      '{{.Server.Version}}') printf '%s\n' "${FAKE_DOCKER_SERVER_VERSION:-28.0.0}" ;;
      '{{.Client.Version}}') printf '%s\n' "${FAKE_DOCKER_CLIENT_VERSION:-99.0.0}" ;;
      *) die "fake docker: unsupported version template: ${tmpl}" ;;
    esac
    ;;
  info)
    # Real `docker info` answers BOTH of these formats, and so does this fake. The adapter only ever
    # asks for SecurityOptions (mi_rt_rootless), but the harness's own suite asserts the server
    # version through `info` — dropping that branch would have broken a passing test for a reason
    # that has nothing to do with the runtime adapter.
    #
    # Every OTHER template used to be answered with the SecurityOptions string, so `info --format
    # '{{.OSType}}'` reported `name=seccomp name=apparmor` and the rootless gate could have been
    # reading any field at all. Same rule as render(): an unimplemented template is a hard error.
    shift; tmpl=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --format) tmpl="$2"; shift 2 ;;
        --format=*) tmpl="${1#--format=}"; shift ;;
        -*) bad_flag "info" "$1" ;;
        *) die "fake docker: info accepts no arguments (got '$1')" ;;
      esac
    done
    # FAKE_DOCKER_INFO_FAIL fabricates a daemon that ANSWERS `version` and fails `info`, and its
    # narrowness is the entire reason it exists rather than being folded into FAKE_DOCKER_DOWN.
    # `mi_rt_rootless` reports "could not ask" (rc 2) when this call fails, and the preflight arm that
    # refuses on it is reached only AFTER a successful ping — which reads `version`. So the only
    # pre-existing way to break `info`, taking the whole daemon down, trips the ping refusal several
    # lines earlier and leaves the rootless-unknown arm unreachable: it could be replaced by a no-op
    # with the entire suite green. A knob is what makes that refusal assertable, and a knob that also
    # broke `version` would recreate the same masking it was added to remove.
    #
    # Answered AFTER the flag parse: an unimplemented flag is a CLI-side error and stays one, in this
    # arm as in every other. The message is this fake's own wording, not a quotation of Docker's — the
    # condition is real (a daemon whose info call errors, an API-version mismatch, a proxy forwarding
    # /version but not /info) but the exact string a real daemon would print is not measured here, and
    # the adapter discards it anyway.
    [ -z "${FAKE_DOCKER_INFO_FAIL:-}" ] || die "Error response from daemon: system info is unavailable"
    if [ -n "${FAKE_DOCKER_ROOTLESS:-}" ]; then secopt='name=rootless name=seccomp '
    else secopt='name=seccomp name=apparmor '; fi
    case "$tmpl" in
      '') printf ' Server Version: %s\n Security Options:\n  %s\n' \
            "${FAKE_DOCKER_SERVER_VERSION:-28.0.0}" "$secopt" ;;
      '{{.ServerVersion}}') printf '%s\n' "${FAKE_DOCKER_SERVER_VERSION:-28.0.0}" ;;
      '{{range .SecurityOptions}}{{.}} {{end}}') printf '%s\n' "$secopt" ;;
      *) die "fake docker: unsupported info template: ${tmpl}" ;;
    esac
    ;;
  context)
    # Same again: this arm printed the endpoint for any template and for any context NAME, so D30's
    # "refuse a remote daemon" check could have been reading a field that is not the endpoint at all.
    # A named context is refused rather than answered as if it were the current one — the adapter
    # asks about the ACTIVE context, and silently treating `inspect other-context` as `inspect` is
    # how a test about the wrong daemon passes.
    shift
    [ "${1:-}" = inspect ] || die "fake docker: unsupported context subcommand: ${1:-}"
    shift; tmpl=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --format) tmpl="$2"; shift 2 ;;
        --format=*) tmpl="${1#--format=}"; shift ;;
        -*) bad_flag "context inspect" "$1" ;;
        *) die "fake docker: context inspect for a named context is not implemented (got '$1')" ;;
      esac
    done
    case "$tmpl" in
      '{{.Endpoints.docker.Host}}') printf '%s\n' "${FAKE_DOCKER_CONTEXT_HOST:-unix:///var/run/docker.sock}" ;;
      *) die "fake docker: unsupported context template: ${tmpl}" ;;
    esac
    ;;

  volume)
    shift
    case "${1:-}" in
      create)
        shift; name=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --label) parse_label "$2"; shift 2 ;;
            --label=*) parse_label "${1#--label=}"; shift ;;
            --) shift ;;
            -*) bad_flag "volume create" "$1" ;;
            *) one_only "$name" "volume create" name "$1"; name="$1"; shift ;;
          esac
        done
        [ -n "$name" ] || die "volume create: no name"
        check_name "$name" volume
        # REAL semantics: an existing name succeeds and the new labels are NOT applied.
        if [ ! -e "$STATE/volumes/$name" ]; then
          : > "$STATE/volumes/$name"
          rec_set "$STATE/volumes/$name" labels "$labels"
          rec_set "$STATE/volumes/$name" driver local
        fi
        printf '%s\n' "$name"
        ;;
      inspect)
        shift; tmpl=""; name=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --format) tmpl="$2"; shift 2 ;;
            --) shift ;;
            -*) bad_flag "volume inspect" "$1" ;;
            # Real docker inspects several objects at once; this fake acts on ONE, and used to act on
            # the LAST silently — `volume inspect a b` answered about b and said nothing about a.
            *) one_only "$name" "volume inspect" name "$1"; name="$1"; shift ;;
          esac
        done
        check_name "$name" volume
        [ -e "$STATE/volumes/$name" ] || die "no such volume: $name"
        # No --format is not an unknown template — it is real docker's default, the whole document.
        # A volume genuinely has no Id, which is what the harness suite pins here.
        if [ -z "$tmpl" ]; then
          printf '{ "Name": "%s", "Labels": "%s", "Driver": "%s" }\n' \
            "$name" "$(rec_get "$STATE/volumes/$name" labels)" "$(rec_get "$STATE/volumes/$name" driver)"
        else
          render "$tmpl" "$STATE/volumes/$name" volume
        fi
        ;;
      ls)
        shift; filt=""; tmpl=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --filter) set_filter "$filt" "volume ls" "$2"; filt="$2"; shift 2 ;;
            --format) tmpl="$2"; shift 2 ;;
            -*) bad_flag "volume ls" "$1" ;;
            *) die "fake docker: volume ls accepts no arguments (got '$1')" ;;
          esac
        done
        check_ls_format volume "$tmpl"
        for v in "$STATE"/volumes/*; do
          [ -e "$v" ] || continue
          case "$(basename "$v")" in *.XXXXXX*|*.tmp*) continue ;; esac
          if [ -n "$filt" ]; then has_label "$(rec_get "$v" labels)" "${filt#label=}" || continue; fi
          basename "$v"
        done
        ;;
      rm)
        # Parse ONLY in the loop. An earlier draft also read $1 before it, which with the adapter's
        # `--` separator set name="" and died on every call — so `uninstall --purge` reported success
        # while removing nothing, and its acceptance case failed for a reason in the harness.
        shift; name=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --) shift ;;
            -*) bad_flag "volume rm" "$1" ;;
            *) one_only "$name" "volume rm" name "$1"; name="$1"; shift ;;
          esac
        done
        [ -n "$name" ] || die "volume rm: no name"
        check_name "$name" volume
        [ -e "$STATE/volumes/$name" ] || die "no such volume: $name"
        # A volume a container MOUNTS cannot be removed — the daemon refuses, and the container keeps
        # its data. This fake removed it and left the mount pointing at nothing, so a teardown that
        # removed volumes before containers passed here and would fail there.
        users="$(container_ids_using_volume "$name")"
        [ -z "$users" ] || die "remove $name: volume is in use - [$users]"
        rm -f "$STATE/volumes/$name"; printf '%s\n' "$name"
        ;;
      *) die "fake docker: unsupported volume subcommand: ${1:-}" ;;
    esac
    ;;

  network)
    shift
    case "${1:-}" in
      create)
        shift; name=""; driver=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --label) parse_label "$2"; shift 2 ;;
            --label=*) parse_label "${1#--label=}"; shift ;;
            --driver) driver="$2"; shift 2 ;;
            --driver=*) driver="${1#--driver=}"; shift ;;
            --) shift ;;
            -*) bad_flag "network create" "$1" ;;
            *) one_only "$name" "network create" name "$1"; name="$1"; shift ;;
          esac
        done
        [ -n "$name" ] || die "network create: no name"
        check_name "$name" network
        check_driver "$driver"
        # The requested driver, then the daemon's default for an omitted flag, then the fabrication
        # knob on top of both. Only the REQUEST goes through check_driver: FAKE_DOCKER_NET_DRIVER
        # exists to produce a network the adapter cannot legitimately create, so validating its value
        # against the same accept-set would defeat the one thing it is for.
        effdrv="$driver"
        [ -n "$effdrv" ] || effdrv="${FAKE_DOCKER_NET_DEFAULT_DRIVER:-bridge}"
        [ -z "${FAKE_DOCKER_NET_DRIVER:-}" ] || effdrv="${FAKE_DOCKER_NET_DRIVER}"
        # D38: Docker does NOT guarantee name-conflict detection for networks, so a delayed original
        # and a reissue can both succeed with the same name AND nonce. Reproduced under the knob;
        # the second record gets a distinct on-disk key so both are listable.
        target="$STATE/networks/$name"
        if [ -e "$target" ]; then
          if [ -n "${FAKE_DOCKER_NET_DUPLICATE:-}" ]; then target="$STATE/networks/${name}#dup$(next_id)"
          else die "network with name $name already exists"; fi
        fi
        id="$(next_id)"
        : > "$target"
        rec_set "$target" id "$id"
        rec_set "$target" name "$name"
        rec_set "$target" labels "$labels"
        rec_set "$target" driver "$effdrv"
        rec_set "$target" thi "${FAKE_DOCKER_NET_THI:-}"
        printf '%s\n' "$id"
        ;;
      inspect)
        shift; tmpl=""; key=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --format) tmpl="$2"; shift 2 ;;
            --) shift ;;
            -*) bad_flag "network inspect" "$1" ;;
            *) one_only "$key" "network inspect" network "$1"; key="$1"; shift ;;
          esac
        done
        # A network is looked up by id OR name, and both go through the same rule: the ids this fake
        # mints are 64 digits, which is inside the class.
        check_name "$key" network
        f="$(find_network "$key")" || die "network $key not found"
        [ -n "$tmpl" ] || die "fake docker: network inspect without --format is not implemented"
        render "$tmpl" "$f" network
        ;;
      ls)
        shift; filt=""; tmpl=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --filter) set_filter "$filt" "network ls" "$2"; filt="$2"; shift 2 ;;
            --format) tmpl="$2"; shift 2 ;;
            -*) bad_flag "network ls" "$1" ;;
            *) die "fake docker: network ls accepts no arguments (got '$1')" ;;
          esac
        done
        check_ls_format network "$tmpl"
        for n in "$STATE"/networks/*; do
          [ -e "$n" ] || continue
          if [ -n "$filt" ]; then has_label "$(rec_get "$n" labels)" "${filt#label=}" || continue; fi
          rec_get "$n" name
        done
        ;;
      rm)
        shift; key=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --) shift ;;
            -*) bad_flag "network rm" "$1" ;;
            *) one_only "$key" "network rm" network "$1"; key="$1"; shift ;;
          esac
        done
        check_name "$key" network
        f="$(find_network "$key")" || die "network $key not found"
        # A network with a container still attached CANNOT be removed. This fake removed it and left
        # every attached container holding an id that resolves to nothing — the exact state §6b's
        # teardown ordering (detach, then remove) exists to avoid, and no test could fail on it.
        eps="$(container_ids_on_network "$(rec_get "$f" id)")"
        [ -z "$eps" ] || die "error while removing network: network $key id $(rec_get "$f" id) has active endpoints"
        rm -f "$f"; printf '%s\n' "$key"
        ;;
      connect)
        shift; alias=""; gw=0; netid=""; c=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --alias) alias="$2"; shift 2 ;;
            --gw-priority) gw="$2"; shift 2 ;;
            --) shift ;;
            -*) bad_flag "network connect" "$1" ;;
            *) if [ -z "$netid" ]; then netid="$1"
               else one_only "$c" "network connect" container "$1"; c="$1"; fi; shift ;;
          esac
        done
        # Both arguments name a resource, and the container one becomes a path directly below.
        check_name "$netid" network
        check_name "$c" container
        # The knob is answered BEFORE the lookup on purpose: it fabricates a daemon-side attach
        # failure, and a fixture using it should not also have to materialise the network. Either way
        # the command fails — the knob can only change which error a caller sees, never whether the
        # attach happens.
        [ -z "${FAKE_DOCKER_CONNECT_FAIL:-}" ] || die "failed to connect $c to $netid"
        # A plain lookup, NOT resolve_netid: connect takes a real network, not a network MODE.
        # `bridge` is not a network this fake holds, and a real daemon refuses `host`/`none` here too
        # (in its own words); the adapter refuses all three before it ever calls this
        # (_mi_rt_netmode_ok), so the only deviation is a stricter answer for `bridge`.
        nf="$(find_network "$netid")" || die "network $netid not found"
        ref="$netid"; netid="$(rec_get "$nf" id)"
        f="$STATE/containers/$c"; [ -e "$f" ] || die "no such container: $c"
        nets="$(rec_get "$f" nets)"; al="$(rec_get "$f" aliases)"
        # A container in PRIVATE (none) mode cannot join a network — the daemon says so in these
        # words, and lib/runtime.sh's D26/D42 comment cites that refusal as the reason `none` is
        # rejected at creation. The fake attached it happily, so the claim the comment makes was
        # modelled nowhere.
        case ";${nets}" in
          *';none='*) die "container cannot be connected to multiple networks with one of the networks in private (none) mode" ;;
        esac
        # Connecting the SAME network twice is a conflict, not a second endpoint. This fake appended
        # one attachment per call, so `c.nets` grew a duplicate id and a reconciliation loop that
        # re-connected on every pass looked idempotent here while erroring against a real daemon.
        case ";${nets}" in
          *";${netid}="*) die "endpoint with name $c already exists in network $ref" ;;
        esac
        if [ "$(rec_get "$f" state)" = running ]; then a="$(addr_for "$c" "$netid")"; else a=""; fi
        rec_set "$f" nets "${nets}${netid}=${a};"
        rec_set "$f" aliases "${al}${netid}:$(alias_list "$alias" "$c");"
        rec_set "$f" gw "$(rec_get "$f" gw)${netid}=${gw};"
        ;;
      disconnect)
        shift; netid=""; c=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --) shift ;;
            -*) bad_flag "network disconnect" "$1" ;;
            *) if [ -z "$netid" ]; then netid="$1"
               else one_only "$c" "network disconnect" container "$1"; c="$1"; fi; shift ;;
          esac
        done
        # The spelling rule first, for BOTH arguments, before any lookup: an invalid name must be
        # refused as a name, not reported as a missing network.
        check_name "$netid" network
        check_name "$c" container
        # Disconnect RESOLVES its network exactly as connect does. This arm took the argument as a
        # literal id and filtered attachments by prefix, so a detach naming the network by NAME
        # matched nothing and reported success, and a detach from a network that does not exist
        # reported success too — an "everything detached" result from a call that detached nothing.
        nf="$(find_network "$netid")" || die "network $netid not found"
        ref="$netid"; netid="$(rec_get "$nf" id)"
        f="$STATE/containers/$c"; [ -e "$f" ] || die "no such container: $c"
        # And a container that is not attached is an ERROR, not a no-op: "everything is detached" and
        # "this was never attached" are the same answer only to a fake.
        case ";$(rec_get "$f" nets)" in
          *";${netid}="*) : ;;
          *) die "container $c is not connected to network $ref" ;;
        esac
        # FAKE_DOCKER_DISCONNECT_SILENT reproduces §10a's "one detach silently fails in phase 4":
        # the command reports success and the attachment survives. It is answered AFTER the checks
        # above, so it fabricates a failed detach of a real attachment and nothing else.
        if [ -z "${FAKE_DOCKER_DISCONNECT_SILENT:-}" ]; then
          rec_set "$f" nets "$(printf '%s' "$(rec_get "$f" nets)" | tr ';' '\n' | grep -av "^${netid}=" | tr '\n' ';' | sed 's/;*$/;/;s/^;$//')"
          rec_set "$f" aliases "$(printf '%s' "$(rec_get "$f" aliases)" | tr ';' '\n' | grep -av "^${netid}:" | tr '\n' ';' | sed 's/;*$/;/;s/^;$//')"
        fi
        ;;
      *) die "fake docker: unsupported network subcommand: ${1:-}" ;;
    esac
    ;;

  container)
    shift
    case "${1:-}" in
      create)
        shift; name=""; image=""; netid=""; alias=""; mounts=""; ports=""; envfile=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --name) name="$2"; shift 2 ;;
            --network) netid="$2"; shift 2 ;;
            --network-alias) alias="$2"; shift 2 ;;
            --env-file) envfile="$2"; shift 2 ;;
            --label) parse_label "$2"; shift 2 ;;
            --label=*) parse_label "${1#--label=}"; shift ;;
            --mount) mounts="${mounts}${2};"; shift 2 ;;
            -p|--publish) ports="${ports}${2};"; shift 2 ;;
            --) shift ;;
            -*) bad_flag "container create" "$1" ;;
            # The word after the image is docker's COMMAND override. This fake let it overwrite the
            # image — `create … -- img sleep infinity` tried to resolve an image called `infinity` —
            # so a fixture passing a command got an error about the wrong thing entirely.
            *) [ -z "$image" ] || die "fake docker: container create with a command is not implemented (got '$1')"
               image="$1"; shift ;;
          esac
        done
        [ -n "$name" ] || die "container create: no name"
        check_name "$name" container
        [ -n "$netid" ] || die "container create: no network"
        # The env file is read by the CLI, before the daemon is contacted, so a missing one is
        # refused FIRST and in the CLI's words. It was not checked at all here, which made
        # lib/runtime.sh's own `[ -f "$envfile" ]` guard the only thing refusing it — and a guard
        # whose absence changes nothing observable is a guard that can be deleted with the suite
        # green. §4.3 puts bootstrap secrets in that file; launching without it is not a detail.
        if [ -n "$envfile" ]; then
          [ -f "$envfile" ] || die "open $envfile: no such file or directory"
        fi
        # In real Docker's order: the image is resolved first, then the name conflict, then the mount
        # config. Every one of these must refuse BEFORE the record is written, or a refused create
        # still leaves a container behind for the next assertion to find.
        require_image "$image"
        [ ! -e "$STATE/containers/$name" ] || die "Conflict. The container name \"/$name\" is already in use"
        # `--network` is RESOLVED, and what comes back is the network's ID: every attachment below is
        # recorded under that, so a caller naming the network is answered with the same id a caller
        # naming the id is. (The relative order of these three refusals is not measured against a real
        # daemon and is not a contract — what is, is that all of them precede the record write.)
        netid="$(resolve_netid "$netid")" || exit 1
        check_mounts "$mounts"
        create_missing_volumes "$mounts"
        f="$STATE/containers/$name"; : > "$f"
        rec_set "$f" id "$(next_id)"
        rec_set "$f" image "$image"
        rec_set "$f" state created
        rec_set "$f" labels "$labels"
        # A created (never started) container has NO address — this is the fidelity D48 needs.
        rec_set "$f" nets "${netid}=;"
        rec_set "$f" aliases "${netid}:$(alias_list "$alias" "$name");"
        rec_set "$f" gw "${netid}=0;"
        rec_set "$f" envfile "$envfile"
        # Ports are recorded in the inspect shape: <cport>/tcp=<hostip>:<hostport>;
        #
        # BOTH publish shapes are parsed, because they mean different things. `<ip>:<host>:<cport>`
        # binds that address; `<host>:<cport>` binds ALL of them, which the daemon reports as
        # 0.0.0.0 — the very address D26/§4b.1 exists to prevent. This arm assumed the three-field
        # form and read the host port as the IP, so a two-field `-p 7480:7480` was recorded as the
        # nonsense `7480/tcp=7480:7480` instead of the 0.0.0.0 binding it actually is, and a test
        # asking "is anything published off-loopback?" would have been answered with gibberish rather
        # than with the address it was looking for.
        pspec=""
        for p in $(printf '%s' "$ports" | tr ';' ' '); do
          case "$p" in
            *:*:*) hip="${p%%:*}"; rest="${p#*:}"; hp="${rest%%:*}"; cp="${rest##*:}" ;;
            *:*)   hip="0.0.0.0"; hp="${p%%:*}"; cp="${p##*:}" ;;
            *)     die "fake docker: a container-port-only publish is not implemented (got '$p')" ;;
          esac
          case "${hp}${cp}" in ''|*[!0-9]*) die "invalid published port: $p" ;; esac
          pspec="${pspec}${cp}/tcp=${hip}:${hp};"
        done
        rec_set "$f" ports "$pspec"
        rec_set "$f" mounts "$(printf '%s' "$mounts" | sed 's/type=volume,source=\([^,]*\),target=\([^,;]*\)/volume|\1||\2|true/g; s/type=bind,source=\([^,]*\),target=\([^,;]*\)/bind||\1|\2|true/g')"
        rec_get "$f" id
        ;;
      start)
        shift; name=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --) shift ;;
            -*) bad_flag "container start" "$1" ;;
            *) one_only "$name" "container start" container "$1"; name="$1"; shift ;;
          esac
        done
        check_name "$name" container
        f="$STATE/containers/$name"; [ -e "$f" ] || die "no such container: $name"
        rec_set "$f" state running
        out=""
        for pair in $(printf '%s' "$(rec_get "$f" nets)" | tr ';' ' '); do
          nid="${pair%%=*}"; out="${out}${nid}=$(addr_for "$name" "$nid");"
        done
        rec_set "$f" nets "$out"
        printf '%s\n' "$name"
        ;;
      stop)
        shift; name=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --) shift ;;
            -*) bad_flag "container stop" "$1" ;;
            *) one_only "$name" "container stop" container "$1"; name="$1"; shift ;;
          esac
        done
        check_name "$name" container
        f="$STATE/containers/$name"; [ -e "$f" ] || die "no such container: $name"
        rec_set "$f" state exited
        # Docker RELEASES the address on stop (verified). Reproducing it is what stops a test from
        # passing because the fake kept an endpoint the real runtime would not have.
        out=""
        for pair in $(printf '%s' "$(rec_get "$f" nets)" | tr ';' ' '); do
          out="${out}${pair%%=*}=;"
        done
        rec_set "$f" nets "$out"
        printf '%s\n' "$name"
        ;;
      rm)
        shift; name=""; force=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            -f|--force) force=1; shift ;;
            --) shift ;;
            -*) bad_flag "container rm" "$1" ;;
            *) one_only "$name" "container rm" container "$1"; name="$1"; shift ;;
          esac
        done
        check_name "$name" container
        f="$STATE/containers/$name"; [ -e "$f" ] || die "no such container: $name"
        # `-f` was PARSED AND DISCARDED, so a RUNNING container was removed either way — and the
        # adapter's `container rm -f` could be reduced to `container rm` with the whole suite green,
        # which is the one thing that makes reconciliation able to clear a live container at all.
        if [ -z "$force" ] && [ "$(rec_get "$f" state)" = running ]; then
          die "You cannot remove a running container $(rec_get "$f" id). Stop the container before attempting removal or force remove"
        fi
        rm -f "$f"; printf '%s\n' "$name"
        ;;
      inspect)
        shift; tmpl=""; name=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --format) tmpl="$2"; shift 2 ;;
            --) shift ;;
            -*) bad_flag "container inspect" "$1" ;;
            *) one_only "$name" "container inspect" container "$1"; name="$1"; shift ;;
          esac
        done
        check_name "$name" container
        [ -e "$STATE/containers/$name" ] || die "No such object: $name"
        [ -n "$tmpl" ] || die "fake docker: container inspect without --format is not implemented"
        render "$tmpl" "$STATE/containers/$name" container
        ;;
      ls)
        # `-a` is HONOURED, not swallowed. Real `container ls` lists only RUNNING containers without
        # it. MEASURED: while this fake ignored the flag, the adapter's `-a` — the thing that stops
        # recovery from missing a stopped container, reissuing, and colliding with what it could not
        # see — could be DELETED with the whole suite still green. A fake that is permissive where
        # the real runtime is strict turns a load-bearing flag into decoration.
        shift; filt=""; all=""; tmpl=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --filter) set_filter "$filt" "container ls" "$2"; filt="$2"; shift 2 ;;
            --format) tmpl="$2"; shift 2 ;;
            -a|--all) all=1; shift ;;
            -*) bad_flag "container ls" "$1" ;;
            *) die "fake docker: container ls accepts no arguments (got '$1')" ;;
          esac
        done
        check_ls_format container "$tmpl"
        for c in "$STATE"/containers/*; do
          [ -e "$c" ] || continue
          if [ -z "$all" ] && [ "$(rec_get "$c" state)" != running ]; then continue; fi
          if [ -n "$filt" ]; then has_label "$(rec_get "$c" labels)" "${filt#label=}" || continue; fi
          basename "$c"
        done
        ;;
      run)
        # The pinned helper (D49/D54). Its result comes from the fixture image script so a test can
        # make the probe answer, fail, or be unobtainable.
        shift
        img=""; cmd=""; mounts=""; netid=""; autorm=""; name=""; netalias=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --rm) autorm=1; shift ;;
            --network) netid="$2"; shift 2 ;;
            --name) name="$2"; shift 2 ;;
            --network-alias) netalias="$2"; shift 2 ;;
            --user) shift 2 ;;
            --label) parse_label "$2"; shift 2 ;;
            --mount) mounts="${mounts}${2};"; shift 2 ;;
            # `-i`/`--interactive` (Task 13, D59 restore): a no-op HERE rather than a knob, because
            # this fake already forwards the invoking process's real stdin to the fixture entrypoint
            # unconditionally, below — it behaves as though `-i` were always given. Accepted (not
            # ignored-and-dropped: it is recognised, tracked, and does nothing further) because a real
            # daemon requires it before it will connect stdin to the container at all, and the adapter
            # (lib/runtime.sh) must be free to send it.
            -i|--interactive) shift ;;
            --) shift ;;
            # `-v /:/hostroot` was SWALLOWED here — a whole-host bind mount that this fake reported
            # as a clean run. Of every silently-ignored flag, that is the one that decides the
            # question: an unimplemented flag has to be fatal.
            -*) bad_flag "container run" "$1" ;;
            # The first positional is the image; everything after it belongs to the container, so the
            # loop STOPS here and never flag-parses a helper argument that happens to start with `-`.
            #
            # The remaining arguments are LEFT IN "$@" rather than flattened into a string. Docker
            # preserves each post-image argument exactly; collapsing them with `rest="$*"` and
            # re-splitting on IFS turned `arg='two words'` into two arguments and glob-expanded
            # `arg='*'` against the fake's working directory — inventing helper behaviour in the one
            # path whose whole purpose is to reproduce it faithfully.
            *) img="$1"; shift; cmd="${1:-}"; shift || true; break ;;
          esac
        done
        # The image gate applies to `run` exactly as it does to `create`: a helper whose pinned image
        # was never pulled is the same defect. Note the wording move — "Unable to find image locally"
        # is now the ABSENT-IMAGE error and no longer doubles as "the fixture entrypoint is unset",
        # which is a harness misconfiguration and says so.
        require_image "$img"
        # `run` resolves the network exactly as `create` does. A fake that is faithful in one arm and
        # permissive in the other is the shape wave 1 already met with the image gate and wave 2 with
        # the name rule: the guard survives, with a door beside it. The probe helper (D42 step 5) is
        # launched onto the family network through THIS arm, so "the probe ran on a network that does
        # not exist" has to be a failure here too. `none` — the copy container's mode (D54) — is a
        # pre-defined mode and needs no lookup.
        # (The resolved id is discarded: `run --rm` records no attachment for anyone to inspect, so
        # the refusal is the whole of what this call is for.)
        rnet=""
        if [ -n "$netid" ]; then rnet="$(resolve_netid "$netid")" || exit 1; fi
        check_mounts "$mounts"
        create_missing_volumes "$mounts"
        # WITHOUT `--rm`, a real daemon LEAVES THE CONTAINER BEHIND when the command exits. This fake
        # left nothing either way, so `--rm` — which is half of what makes the pinned helpers safe to
        # run at all (D49/D54: no helper may outlive its own invocation) — could be dropped from the
        # adapter with the whole suite green and no orphan anywhere for a test to find.
        # The container is recorded BEFORE the entrypoint runs, because a helper that fails leaves
        # one behind too; docker's own generated name is random, so `run-<id>` stands in for it.
        if [ -z "$autorm" ]; then
          [ -n "$name" ] || name="run-$(next_id)"
          check_name "$name" container
          [ ! -e "$STATE/containers/$name" ] || die "Conflict. The container name \"/$name\" is already in use"
          rf="$STATE/containers/$name"; : > "$rf"
          rec_set "$rf" id "$(next_id)"
          rec_set "$rf" image "$img"
          rec_set "$rf" state exited
          rec_set "$rf" labels "$labels"
          rec_set "$rf" nets "${rnet}=;"
          rec_set "$rf" aliases "${rnet}:$(alias_list "$netalias" "$name");"
        fi
        [ -z "${FAKE_DOCKER_HELPER_FAIL:-}" ] || die "helper: ${FAKE_DOCKER_HELPER_FAIL}"
        [ -x "${FAKE_HELPER_BIN:-}" ] || die "fake docker: FAKE_HELPER_BIN is not set to an executable fixture entrypoint"
        # The two surfaces (see dns_view_for above), built for THIS container and handed to the
        # entrypoint. The container's own registrations go in the DNS view because that is where the
        # daemon puts them — its name and every alias — and the hosts view gets its HOSTNAME and
        # nothing else, which is what the daemon writes into the file.
        dnsview=""; hostsview="localhost=127.0.0.1;"; ownaddr=""
        hostid="$(short_id "${name:-helper}")"
        if [ -n "$rnet" ] && [ "$rnet" != none ]; then
          dnsview="$(dns_view_for "$rnet")"
          ownaddr="$(addr_for "${name:-$hostid}" "$rnet")"
          [ -z "$netalias" ] || dnsview="${dnsview}${netalias}=${ownaddr};"
          [ -z "$name" ] || dnsview="${dnsview}${name}=${ownaddr};"
          hostsview="${hostsview}${hostid}=${ownaddr};"
        fi
        # `${1+"$@"}` rather than a bare "$@": under `set -u`, bash 3.2 errors on "$@" when there are
        # no positional parameters left, which is the ordinary case for a no-argument helper command.
        HELPER_NET_DNS="$dnsview" HELPER_NET_HOSTS="$hostsview" HELPER_NET_HOSTNAME="$hostid" \
          "$FAKE_HELPER_BIN" "$cmd" ${1+"$@"}
        ;;
      *) die "fake docker: unsupported container subcommand: ${1:-}" ;;
    esac
    ;;

  image)
    shift
    case "${1:-}" in
      pull)
        shift; ref=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --) shift ;;
            -*) bad_flag "image pull" "$1" ;;
            *) one_only "$ref" "image pull" reference "$1"; ref="$1"; shift ;;
          esac
        done
        [ -n "$ref" ] || die "image pull: no reference"
        case "${FAKE_DOCKER_PULL:-ok}" in
          ok)       k="$(image_key "$ref")"
                    : > "$k"
                    rec_set "$k" ref "$ref"
                    # The image ID is minted ONCE, at pull, and stored. It used to be minted per
                    # inspect, so two inspects of the same image reported different ids — an image
                    # that appeared to change identity between two reads, which is the opposite of
                    # what a digest-pinned reference means.
                    rec_set "$k" imgid "sha256:$(next_id)"
                    printf 'Status: Downloaded newer image for %s\n' "$ref" ;;
          notfound) die "manifest for $ref not found: manifest unknown" ;;
          auth)     die "denied: requested access to the resource is denied" ;;
          neterr)   die "dial tcp: lookup registry: no such host" ;;
          *)        die "unknown FAKE_DOCKER_PULL outcome" ;;
        esac
        ;;
      inspect)
        shift; tmpl=""; ref=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --format) tmpl="$2"; shift 2 ;;
            --) shift ;;
            -*) bad_flag "image inspect" "$1" ;;
            *) one_only "$ref" "image inspect" reference "$1"; ref="$1"; shift ;;
          esac
        done
        [ -n "$ref" ] || die "image inspect: no reference"
        k="$(image_key "$ref")"
        [ -e "$k" ] || die "No such image: $ref"
        [ -n "$tmpl" ] || die "fake docker: image inspect without --format is not implemented"
        if [ "$tmpl" = '{{.Id}}' ]; then printf '%s\n' "$(rec_get "$k" imgid)"; else render "$tmpl" "$k" image; fi
        ;;
      *) die "fake docker: unsupported image subcommand: ${1:-}" ;;
    esac
    ;;

  *) die "fake docker: unsupported command: ${1:-}" ;;
esac
